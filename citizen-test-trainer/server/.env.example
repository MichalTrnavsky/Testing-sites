# Copy to .env and load it with your process manager.

# Port + public URL of the deployment (used in Stripe redirect + magic links)
PORT=8080
PUBLIC_URL=http://localhost:8080

# Storage (SQLite file; default server/data.sqlite)
# DB_PATH=/var/lib/citizenprep/data.sqlite

# Price — used when no STRIPE_PRICE_ID is set. Defaults: 499 SEK.
# PRICE_AMOUNT=499
# PRICE_CURRENCY=sek

# Stripe — leave unset for dev mode (purchases grant access instantly).
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID=price_...

# Transactional email — leave unset to log emails to the console (dev).
# EMAIL_PROVIDER=postmark
# EMAIL_API_KEY=...
# EMAIL_FROM=CitizenPrep <no-reply@citizenprep.dk>

# Protect /api/metrics in production
# METRICS_TOKEN=change-me
