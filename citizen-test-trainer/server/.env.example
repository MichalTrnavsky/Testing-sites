# Copy to .env and `export $(cat .env | xargs)` or use your process manager.

# Port + public URL of the deployment (used in Stripe redirect URLs)
PORT=8080
PUBLIC_URL=http://localhost:8080

# Stripe — leave unset for dev mode (purchases grant access instantly).
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Either a pre-created Price…
# STRIPE_PRICE_ID=price_...
# …or an ad-hoc amount in DKK (default 149):
# PRICE_DKK=149
